  ],
  "flows": [
    {
      "id": "meal",
      "title": "完成一次选餐",
      "summary": "从描述需求，到确认这一餐的餐品与费用。",
      "steps": [
        {
          "id": "home",
          "label": "说清这一餐",
          "caption": "预算、人数和口味从一个入口开始。",
          "reason": "用户可以描述需求，不必先浏览所有店铺；常用偏好只作为补充。"
        },
        {
          "id": "recommend",
          "label": "查看推荐理由",
          "caption": "先给出有依据的候选，缩小选择范围。",
          "reason": "候选需要匹配已有菜单与价格；本轮忌口优先于历史偏好。"
        },
        {
          "id": "followup",
          "label": "比较与追问",
          "caption": "保留上下文，继续比较合适的候选。",
          "reason": "追问承接已确认的条件，用户无需重新输入全部要求。"
        },
        {
          "id": "water",
          "label": "调整饮品",
          "caption": "替换饮品时，保留已选餐品与预算。",
          "reason": "一次替换只改变相应条目，并重新计算餐费。"
        },
        {
          "id": "confirm",
          "label": "确认这一餐",
          "caption": "核对菜品、数量与餐费小计。",
          "reason": "确认页把连续对话收敛为可检查的选择，配送费用单独说明。"
        },
        {
          "id": "compare",
          "label": "同店比价",
          "caption": "选好餐品后，再比较平台付款条件。",
          "reason": "先对齐店铺、菜品与份量，再解释运费和优惠。支付在外部平台完成。"
        }
      ]
    },
    {
      "id": "browse",
      "title": "查看餐厅与菜单",
      "summary": "从餐厅详情进入菜单，再核实评价和平台费用。",
      "steps": [
        {
          "id": "explore",
          "label": "探索餐厅",
          "caption": "从菜系与场景开始找一家店。",
          "reason": "探索入口服务于还没有明确需求的用户，与对话入口互相补充。"
        },
        {
          "id": "restaurant",
          "label": "了解餐厅",
          "caption": "查看餐厅信息，再决定是否继续。",
          "reason": "餐厅信息提供选择依据，未知状态应去平台核实。"
        },
        {
          "id": "menu",
          "label": "浏览菜单",
          "caption": "按具体菜品和标价做选择。",
          "reason": "菜单数据是推荐和价格校验的依据。"
        },
        {
          "id": "combo",
          "label": "查看套餐",
          "caption": "把组合与单品分开理解。",
          "reason": "套餐份量和内容需要明确，不能只比较一个总价。"
        },
        {
          "id": "reviews",
          "label": "查看评价",
          "caption": "用评价补充选餐判断。",
          "reason": "评价是辅助信息，用户仍可返回菜单调整选择。"
        },
        {
          "id": "delivery",
          "label": "核实费用",
          "caption": "区分餐品金额与平台费用。",
          "reason": "配送费和优惠可能变化，下单前由外部平台最终确认。"
        }
      ]
    },
    {
      "id": "reuse",
      "title": "偏好与再次使用",
      "summary": "保存偏好、收藏餐厅，并找回之前的选择。",
      "steps": [
        {
          "id": "taste",
          "label": "设置饮食偏好",
          "caption": "为下一次推荐提供口味参考。",
          "reason": "长期偏好可以减少重复输入，但不能覆盖当次明确要求。"
        },
        {
          "id": "order",
          "label": "设置平台偏好",
          "caption": "记录常用平台与下单习惯。",
          "reason": "平台偏好帮助筛选，不应掩盖费用差异。"
        },
        {
          "id": "save",
          "label": "选择收藏夹",
          "caption": "把这次发现保存到合适的位置。",
          "reason": "收藏是以后重新找到餐厅的入口，和提交订单分开。"
        },
        {
          "id": "saved",
          "label": "回到收藏",
          "caption": "下次可直接找到已保存的选择。",
          "reason": "通过明确的收藏入口承接复访，不让内容只留在对话里。"
        },
        {
          "id": "history",
          "label": "找回会话",
          "caption": "继续查看之前的选餐过程。",
          "reason": "历史保留上下文，方便回顾当时的预算和选择理由。"
        }
      ]
    }
  ]
