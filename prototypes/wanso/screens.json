  "flows": [
    {
      "id": "meal",
      "title": "汉堡选餐 · 60,000 ₫ 预算",
      "summary": "同一段选餐对话：双层牛肉芝士、不吃鸡、不喝汽水，最后选择汉堡配水。",
      "steps": [
        {
          "id": "recommend",
          "label": "理解本次要求",
          "caption": "牛肉芝士、不要鸡肉，餐费上限 60,000 ₫。",
          "reason": "原稿第 8 页：首选 Bamysu 49,000 ₫ 双层芝士汉堡。菜单价格与解释使用同一依据。"
        },
        {
          "id": "alternative",
          "label": "了解第二家候选",
          "caption": "再看麦当劳的 59,000 ₫ 备选。",
          "reason": "这是同一次推荐的第二家餐厅；先展示备选，后续“第二家”才有明确指代。"
        },
        {
          "id": "followup",
          "label": "追问第二家贵不贵",
          "caption": "沿用刚才的候选顺序，比较单点和套餐。",
          "reason": "原稿第 9 页：用户追问第二家，指向麦当劳，不应突然换成其他餐厅。"
        },
        {
          "id": "water",
          "label": "保留汉堡，搭配水",
          "caption": "49,000 ₫ 汉堡 + 10,000 ₫ 水 = 59,000 ₫。",
          "reason": "继承双层牛肉的选择，把“不喝汽水”落实为矿泉水；这里是餐费，尚未计配送。"
        },
        {
          "id": "egg",
          "label": "比较加蛋的取舍",
          "caption": "含蛋组合 55,000 ₫；再带水则超预算。",
          "reason": "原稿第 13 页：单独加蛋需 59,000 ₫，现成含蛋汉堡 55,000 ₫；含蛋再带水为 65,000 ₫。不能把更便宜的单品误写成更便宜的一餐。"
        },
        {
          "id": "confirm",
          "label": "最终选择汉堡配水",
          "caption": "确认 59,000 ₫ 餐费，再前往 GrabFood。",
          "reason": "用户最终保留双层芝士汉堡与水，没有采用加蛋方案。原稿此处不接烤鸡比价，那是另一个示例。"
        }
      ]
